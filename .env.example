# Copy to .env (gitignored). Every setting can also come from a YAML file: literag -c rag.yaml ...
LITERAG_DATABASE_URL=postgresql://lite_rag:<password>@localhost:5432/lite_rag
# Tests: set explicitly; they only use (drop and recreate) the schema lite_rag_test.
LITERAG_TEST_DATABASE_URL=postgresql://lite_rag:<password>@localhost:5432/lite_rag
# LITERAG_STORE__SCHEMA=lite_rag
# LITERAG_EMBEDDING__MODEL=bge-m3:567m
# LITERAG_EMBEDDING__BASE_URL=http://127.0.0.1:11434
# LITERAG_CHUNKING__STRATEGY=recursive
# LLM settings are lite-model's (design §6, S15). The top level moves answers; contexts and graphs
# keep their own model (index identity) unless LITERAG_LLM__ROLES names them.
# LITERAG_LLM__BACKEND=ollama           # ollama | openai | anthropic | gateway | litellm, or one you name
# LITERAG_LLM__MODEL=qwen3:8b
# LITERAG_LLM__REASONING_EFFORT=none    # qwen3 on Ollama: no thinking (much faster)
# LITERAG_LLM__ROLES='{"graph": {"model": "qwen3:14b"}}'
# An OpenAI-compatible vendor under the `openai` name (answers record openai/<model>); the key is
# read from the variable api_key_env names, never written here:
# LITERAG_LLM__BACKENDS='{"openai": {"base_url": "https://api.deepseek.com/v1", "api_key_env": "DEEPSEEK_API_KEY"}}'
# LITERAG_RERANK__ENABLED=true          # needs the fastembed extra
