# Copy to .env (gitignored). Every setting can also come from a YAML file: literag -c rag.yaml ...
LITERAG_DATABASE_URL=postgresql://lite_rag:<password>@localhost:5432/lite_rag
# Tests: set explicitly; they only use (drop and recreate) the schema lite_rag_test.
LITERAG_TEST_DATABASE_URL=postgresql://lite_rag:<password>@localhost:5432/lite_rag
