# Copy to deploy/.env (gitignored) for deploy/compose.yaml.
LITERAG_DB_PASSWORD=<a password for the bundled database>
# The JSON line printed by `uv run literag key create --name me --namespace 'demo/*' --mode write`
LITERAG_SERVER__KEYS=[{"name": "me", "sha256": "<64 hex>", "namespaces": ["demo/*"], "kbs": ["*"], "mode": "write"}]
# LITERAG_PORT=8700
